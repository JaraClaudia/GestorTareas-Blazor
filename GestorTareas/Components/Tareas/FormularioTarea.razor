@using GestorTareas.Models

<EditForm Model="Tarea" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="row g-2 mb-3">
        <div class="col-12 col-md-4">
            <label>Título:</label>
            <InputText @bind-Value="Tarea.Titulo" class="form-control" />
            <ValidationMessage For="() => Tarea.Titulo" />
        </div>

        <div class="col-12 col-md-4">
            <label>Descripción:</label>
            <InputText @bind-Value="Tarea.Descripcion" class="form-control" />
            <ValidationMessage For="() => Tarea.Descripcion" />
        </div>

        <div class="col-12 col-md-4">
            <label>Categoría:</label>
            <InputSelect @bind-Value="Tarea.CategoriaId" class="form-select">
                <option value="0">Seleccione...</option>
                @foreach (var c in Categorias)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </InputSelect>
            <ValidationMessage For="() => Tarea.CategoriaId" />
        </div>

        <div class="col-6 col-md-3">
            <label>Prioridad:</label>
            <InputSelect @bind-Value="Tarea.Prioridad" class="form-select">
                <option value="Alta">Alta</option>
                <option value="Media">Media</option>
                <option value="Baja">Baja</option>
            </InputSelect>
        </div>

        <div class="col-6 col-md-3">
            <label>Vencimiento:</label>
            <InputDate @bind-Value="Tarea.FechaVencimiento" class="form-control" />
            <ValidationMessage For="() => Tarea.FechaVencimiento" />
        </div>

        @if (MostrarCompletada)
        {
            <div class="col-12">
                <div class="form-check">
                    <InputCheckbox @bind-Value="Tarea.Completada" class="form-check-input" id="completada" />
                    <label class="form-check-label" for="completada">Completada</label>
                </div>
            </div>
        }

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@TextoBoton</button>
            @if (OnCancelar.HasDelegate)
            {
                <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
            }
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public TareaEntity Tarea { get; set; } = default!;

    [Parameter]
    public List<Categoria> Categorias { get; set; } = new();

    [Parameter]
    public string TextoBoton { get; set; } = "Guardar";

    [Parameter]
    public bool MostrarCompletada { get; set; }

    [Parameter]
    public EventCallback OnGuardar { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    private Task Guardar() => OnGuardar.InvokeAsync();

    private Task Cancelar() => OnCancelar.InvokeAsync();
}
