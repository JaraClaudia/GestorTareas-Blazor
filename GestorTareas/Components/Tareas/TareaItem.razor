@using GestorTareas.Models
@inject IJSRuntime JS

<article class="card card-tarea mb-2">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="@(Tarea.Completada ? "completada" : "")">
            <strong>@Tarea.Titulo</strong>
            <p class="text-muted mb-0">@Tarea.Descripcion</p>
            @if (Tarea.Categoria is not null)
            {
                <span class="badge bg-secondary">@Tarea.Categoria.Nombre</span>
            }
        </div>
        <BadgePrioridad Prioridad="@Tarea.Prioridad" />
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-sm btn-outline-success" @onclick="CompletarClick">
                @(Tarea.Completada ? "Reabrir" : "Completar")
            </button>
            <a href="/tareas/@Tarea.Id">Ver detalle</a>
            <a href="/tareas/@Tarea.Id/editar">Editar</a>
            <button class="btn btn-sm btn-danger" @onclick="EliminarClick">Eliminar</button>
        </div>
    </div>
</article>

@code {
    [Parameter]
    public TareaEntity Tarea { get; set; } = default!;

    [Parameter]
    public EventCallback<int> OnEliminar { get; set; }

    [Parameter]
    public EventCallback<int> OnCompletar { get; set; }

    private async Task CompletarClick()
    {
        await OnCompletar.InvokeAsync(Tarea.Id);
    }

    private async Task EliminarClick()
    {
        bool confirmado = await JS.InvokeAsync<bool>(
            "confirmarEliminacion",
            $"¿Estás segura de eliminar la tarea \"{Tarea.Titulo}\"?");

        if (confirmado)
        {
            await OnEliminar.InvokeAsync(Tarea.Id);
        }
    }
}