@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header class="top-row px-4">
            <span class="fw-semibold">Gestor de Tareas</span>
        </header>

        <article class="content px-4">
            @Body
        </article>

        <footer class="px-4 py-3 text-muted small">
            <p class="mb-0">Gestor de Tareas &copy; @DateTime.Now.Year</p>
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>